# Averro monorepo — environment template. Copy to .env / apps/web/.env.local and
# fill locally. NEVER commit real values. Only *.env.example are tracked.
#
# Classification legend:
#   [public]      safe to expose to the browser (NEXT_PUBLIC_*)
#   [server]      server-only secret — NEVER in a NEXT_PUBLIC_* var or client bundle
#   [local]       developer machine only
#   [ci]          set as a CI secret/variable
#   [staging]     staging environment
#   [production]  production environment
#
# The full application variables live in apps/web/.env.example. This root file
# documents the classification and the monorepo-wide (non-app) variables.

# --- Monorepo build (non-app) ---
# [local][ci] Reproducible-builds timestamp; when set, AMA compile output is
# byte-identical. scripts/compile-architecture.sh defaults it to 1700000000.
SOURCE_DATE_EPOCH=""
# [local] Override the Python used by the AMA scripts (defaults to the venv).
AMA_PYTHON=""

# --- apps/web (see apps/web/.env.example for the authoritative list) ---
# [public]
NEXT_PUBLIC_APP_NAME="Averro Content OS"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# [server] server-only secrets — must never be NEXT_PUBLIC_* or reach the client
SUPABASE_SERVICE_ROLE_KEY=""
TOKEN_ENCRYPTION_KEY=""
META_APP_SECRET=""
# [local][staging][production] non-secret configuration
SUPABASE_PROJECT_REF=""
META_APP_ID=""
META_API_VERSION="v25.0"
