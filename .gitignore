# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo root .gitignore — patterns are unrooted so they match at any depth
# (apps/*, packages/*, services/*).

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# python (packages/ama-python)
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.determinism/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real env; .env.example is the only tracked one)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# AMA raw compile output (reproducible; only the stable exports are versioned)
/generated/architecture/
