NEXT_PUBLIC_APP_NAME="Averro Content OS"
NEXT_PUBLIC_APP_SHORT_NAME="Averro"
NEXT_PUBLIC_APP_TIMEZONE="America/Sao_Paulo"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROJECT_REF=""

# Geração de texto/imagem/vídeo usa providers locais (src/lib/providers/registry.ts),
# sem custo variável. Política de custo zero: ver ARCHITECTURE.md.
# Não há — e não deve haver — OPENAI_API_KEY / ANTHROPIC_API_KEY / chaves pay-as-you-go
# aqui como caminho de funcionamento padrão.

# Chave simétrica para criptografar tokens de conexões sociais (AES-256-GCM).
# Gerada com: openssl rand -base64 32 — NUNCA reaproveitar entre ambientes.
TOKEN_ENCRYPTION_KEY=""

# Instagram — modo single-owner (Instagram API with Instagram Login, sem
# Facebook Page). Credenciais do Meta App privado (não são chaves de consumo
# por token, ficam só no backend). Crie o app em developers.facebook.com/apps,
# mantenha em Development Mode, adicione o produto Instagram, e adicione a si
# mesmo como Instagram Tester (aceitando o convite dentro do próprio Instagram).
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v25.0"
META_WEBHOOK_VERIFY_TOKEN=""

# Allowlist: só a conta do proprietário pode conectar (fail-closed por padrão
# — sem allowlist configurada, nenhuma conta é aceita).
INSTAGRAM_ALLOWED_ACCOUNT_IDS=""
INSTAGRAM_ALLOWED_USERNAMES=""

# Demais redes sociais (fase 6, ainda não implementadas). Cada uma exige
# registrar um app OAuth próprio no painel de desenvolvedores da plataforma
# antes de a conexão poder sair do status "blocked_official_auth_unavailable".
FACEBOOK_OAUTH_CLIENT_ID=""
FACEBOOK_OAUTH_CLIENT_SECRET=""
TWITTER_OAUTH_CLIENT_ID=""
TWITTER_OAUTH_CLIENT_SECRET=""
YOUTUBE_OAUTH_CLIENT_ID=""
YOUTUBE_OAUTH_CLIENT_SECRET=""
GOOGLE_BUSINESS_OAUTH_CLIENT_ID=""
GOOGLE_BUSINESS_OAUTH_CLIENT_SECRET=""
OAUTH_REDIRECT_BASE_URL="http://localhost:3000"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
