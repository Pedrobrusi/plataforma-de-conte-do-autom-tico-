{
  "name": "averro-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Averro monorepo — Next.js content platform (apps/web) plus the AMA/AMDL meta-architecture foundation.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "npm run test:unit --workspace apps/web",
    "test:unit": "npm run test:unit --workspace apps/web",
    "test:e2e": "npm run test:e2e --workspace apps/web"
  }
}
